# Скопируй этот файл в .env и заполни. .env никому не показывать и не коммитить.

# Ключ доступа сообщества (Управление -> Работа с API -> Ключи доступа -> Создать ключ)
VK_COMMUNITY_TOKEN=

# Личный ключ админа (опционально, нужен для публикации предложки; получим вместе)
VK_USER_TOKEN=

# id группы без минуса
VK_GROUP_ID=69451964

# Токен телеграм-бота от @BotFather
TG_BOT_TOKEN=

# Прокси для Telegram (нужен только на российском сервере, формат socks5://user:pass@host:port)
TG_PROXY=

# Чат админа определится сам при первом /start — можно не заполнять
TG_ADMIN_CHAT_ID=
